# Copy to .env and fill in. OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Apify token (https://console.apify.com/account/integrations) enables Instagram / Facebook sources.
# Without it the pipeline runs on websites only.
APIFY_API_KEY=apify_api_...

# Models routed through OpenRouter (all optional, these are the defaults)
EXTRACTOR_MODEL=anthropic/claude-sonnet-5          # independent reader + schema generator
VERIFIER_MODEL=google/gemini-3.8-flash             # adversarial verifier (different family on purpose)
DISCOVER_MODEL=anthropic/claude-sonnet-5           # tool-using source discovery
SEARCH_MODEL=openai/gpt-5.4-mini                   # carrier for OpenRouter's web-search plugin
VISION_MODEL=qwen/qwen3-vl-32b-instruct            # reads social posts: caption + flyer images
VISION_VERIFIER_MODEL=deepseek/deepseek-v4.1-flash # adversarial verifier for social posts (vision, different family)
